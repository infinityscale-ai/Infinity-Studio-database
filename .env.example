# Infinity Studio server settings. Copy to .env (gitignored) and fill only what you need.
# Every value is optional: with nothing set, the studio listens on 127.0.0.1:3867 with no access key
# and serves the local tools (database detection on this computer, Localhost and Oracle Cloud forms).

# ---- Listener ----
# Address and port of the web UI and API (defaults 127.0.0.1 and 3867)
INFSTUDIO_BIND=
INFSTUDIO_SERVER_PORT=
# Required as soon as INFSTUDIO_BIND is not loopback; generate with: openssl rand -hex 32
INFSTUDIO_API_KEY=
# Only behind a trusted proxy that already authenticates: 1 lets a non-loopback bind run without a key
INFSTUDIO_ALLOW_UNAUTHENTICATED=
# Extra browser origins allowed to call the API, comma-separated
INFSTUDIO_CORS_ORIGINS=

# ---- Files ----
# Where saved connections and studio data live (default: the working directory; Docker uses /data)
INFSTUDIO_USER_DATA_DIR=
# Built web UI to serve (the image sets /app/out); empty when the UI runs from `next dev`
INFSTUDIO_STATIC_DIR=

# ---- Local tools ----
# 1 forces database detection and the Localhost / Oracle Cloud forms on, 0 off (default: on only without an access key)
INFSTUDIO_LOCAL_TOOLS=
# How the studio names this computer (default 127.0.0.1 natively, host.docker.internal in Docker)
INFSTUDIO_HOST_ALIAS=
# Where your Oracle Cloud sign-in lives (default ~/.oci); sign in with: oci session authenticate --profile-name <profile> --region <region>
INFSTUDIO_OCI_DIR=

# ---- Embedded in a console (InfinityScale /databases) ----
# 1 runs the studio as an embedded viewer; needs the admin listener below
INFSTUDIO_EMBED_MODE=
# Console origins allowed to frame the studio, comma-separated
INFSTUDIO_EMBED_ALLOWED_ORIGINS=
INFSTUDIO_CONSOLE_ORIGIN=
# Look of the embedded studio (an app theme id, and optionally an editor theme id)
INFSTUDIO_EMBED_THEME=
INFSTUDIO_EMBED_EDITOR_THEME=
# Admin API the console uses to mint sessions: port, bind address, and a key of at least 32 characters
INFSTUDIO_ADMIN_PORT=
INFSTUDIO_ADMIN_BIND=
INFSTUDIO_ADMIN_KEY=

# ---- Optional features ----
# 1 turns off the built-in MCP server
INFSTUDIO_MCP_DISABLED=
